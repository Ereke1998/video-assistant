{
  "$comment": "Единый источник правды. Ролик целиком генерируется кодом: сценарий → TTS-озвучка → выравнивание слов → субтитры → Remotion/HyperFrames. Записей экрана и голоса автора нет. Правки на естественном языке вносятся сюда + строкой в edits.md.",
  "project": {
    "name": "untitled",
    "date": "YYYY-MM-DD",
    "language": "ru",
    "platform": [
      "reels",
      "tiktok"
    ],
    "target_duration_sec": 30,
    "goal": "",
    "cta": ""
  },
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_zone": {
      "top_pct": 10,
      "bottom_pct": 20,
      "side_px": 60
    }
  },
  "references": {
    "urls": [],
    "download_dir": "references/downloads",
    "analysis_file": "references/analysis.md",
    "rule": "Вдохновляйся, но не копируй: берём темп, тип хука, ритм субтитров — не текст, не кадры, не графику"
  },
  "script": {
    "$comment": "Бриф для pipeline/generate_script.py. Пустой voice хука заполняется по hook.formula; остальные сцены пишет ассистент.",
    "topic": "",
    "audience": "",
    "tone": "энергично, по делу",
    "hook": {
      "formula": "mistake",
      "formulas_available": [
        "question",
        "number",
        "mistake",
        "secret",
        "before_after"
      ],
      "number": 3,
      "max_sec": 3
    },
    "pace_wps": {
      "ru": 2.3,
      "kk": 2.0
    },
    "max_words_per_scene": 14,
    "output_json": "build/script.json",
    "output_md": "script.md",
    "voiceover_md": "voiceover.md"
  },
  "scenes": [
    {
      "id": "hook",
      "role": "hook",
      "voice": "",
      "visual": {
        "engine": "remotion",
        "component": "Hook",
        "props": {
          "title": "",
          "scale": 1.0
        }
      },
      "transition": "zoom",
      "sfx": [
        "whoosh"
      ]
    },
    {
      "id": "problem",
      "role": "problem",
      "voice": "",
      "visual": {
        "engine": "remotion",
        "component": "Plate",
        "props": {
          "title": "",
          "subtitle": "",
          "emoji": ""
        }
      },
      "transition": "slide",
      "sfx": [
        "pop"
      ]
    },
    {
      "id": "steps",
      "role": "value",
      "voice": "",
      "visual": {
        "engine": "remotion",
        "component": "List",
        "props": {
          "title": "",
          "items": []
        }
      },
      "transition": "slide",
      "sfx": [
        "pop"
      ]
    },
    {
      "id": "proof",
      "role": "value",
      "voice": "",
      "visual": {
        "engine": "remotion",
        "component": "Infographic",
        "props": {
          "items": [
            {
              "label": "Было",
              "value": 10
            },
            {
              "label": "Стало",
              "value": 85
            }
          ]
        }
      },
      "transition": "zoom",
      "sfx": [
        "riser"
      ]
    },
    {
      "id": "demo",
      "role": "value",
      "enabled": false,
      "voice": "",
      "visual": {
        "engine": "hyperframes",
        "file": "graphics/hyperframes/index.html",
        "render": "build/renders/hf_demo.mp4"
      },
      "transition": "slide",
      "sfx": []
    },
    {
      "id": "cta",
      "role": "cta",
      "voice": "",
      "visual": {
        "engine": "remotion",
        "component": "CTA",
        "props": {
          "text": ""
        }
      },
      "transition": "zoom",
      "sfx": [
        "impact"
      ]
    }
  ],
  "scene_components": {
    "$comment": "Доступные визуалы Remotion для scenes[].visual.component",
    "Hook": "крупный заголовок с pop/rotate, props: title, scale",
    "Plate": "плашка с заголовком, подзаголовком, эмодзи, props: title, subtitle, emoji",
    "List": "пункты появляются по очереди, props: title, items[]",
    "Infographic": "анимированные бары со счётчиком, props: items[{label,value}]",
    "Counter": "большая цифра с отсчётом, props: from, to, suffix, label",
    "Code": "блок кода с эффектом печати, props: code, language",
    "CTA": "пульсирующая кнопка-призыв, props: text"
  },
  "voiceover": {
    "engine": "edge-tts",
    "engines_available": [
      "edge-tts",
      "preview"
    ],
    "voices": {
      "ru": "ru-RU-DmitryNeural",
      "kk": "kk-KZ-DauletNeural"
    },
    "rate": "+8%",
    "pitch": "+0Hz",
    "pad_after_sec": 0.15,
    "lufs": -14,
    "output": "build/audio/voiceover.mp3",
    "timeline_json": "build/timeline.json"
  },
  "alignment": {
    "engine": "faster-whisper",
    "fallback": "estimate",
    "model": "large-v3",
    "snap_to_script": true,
    "output_json": "build/audio/words.json"
  },
  "subtitles": {
    "words_per_block": {
      "min": 2,
      "max": 4
    },
    "min_block_sec": 0.5,
    "max_block_sec": 2.0,
    "keywords": [],
    "auto_accent": {
      "numbers": true,
      "caps_words": true
    },
    "hide_on_scenes": [
      "hook"
    ],
    "style": {
      "font": "Montserrat",
      "weight": 800,
      "size_px": 78,
      "color": "#FFFFFF",
      "accent_color": "#FFD400",
      "accent_scale": 1.15,
      "stroke_px": 6,
      "stroke_color": "#000000",
      "position_y_pct": 66,
      "animation": "pop",
      "uppercase": false
    },
    "output_srt": "subtitles/subtitles.srt",
    "output_json": "subtitles/subtitles.json"
  },
  "theme": {
    "background": {
      "type": "gradient",
      "colors": [
        "#0F1020",
        "#2A1B5C",
        "#0B3D5C"
      ],
      "motion": true,
      "grid": true
    },
    "plate": {
      "bg": "rgba(255,255,255,0.08)",
      "border": "rgba(255,255,255,0.18)",
      "radius": 40,
      "blur_px": 20
    },
    "text_color": "#FFFFFF",
    "accent_color": "#FFD400",
    "font": "Montserrat"
  },
  "audio": {
    "music": {
      "file": "",
      "volume_db": -20
    },
    "sfx_enabled": false,
    "sfx_files": {
      "whoosh": "sfx/whoosh.mp3",
      "pop": "sfx/pop.mp3",
      "riser": "sfx/riser.mp3",
      "impact": "sfx/impact.mp3"
    },
    "sfx_volume_db": -10
  },
  "render": {
    "codec": "h264",
    "crf": 18,
    "output": "build/renders/final.mp4"
  }
}
