{
  "name": "prime-it-reels",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render ReelsVideo out/prime_it_reels.mp4 --codec=h264",
    "stills": "node scripts/stills.mjs",
    "timings": "node --experimental-strip-types --no-warnings scripts/build-timings.mjs",
    "srt": "node --experimental-strip-types --no-warnings scripts/export-srt.mjs",
    "audio": "python3 scripts/gen_audio.py"
  },
  "dependencies": {
    "@react-three/fiber": "9.3.0",
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "@remotion/layout-utils": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/three": "4.0.545",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.545",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/three": "0.180.0",
    "typescript": "5.8.3"
  }
}
